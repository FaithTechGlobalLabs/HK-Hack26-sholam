# Copy to .env.local and fill in. Never commit .env.local.

# --- Model -------------------------------------------------------------
# OpenRouter (the team's route): its Anthropic-compatible endpoint, used
# through the Anthropic SDK. Key from https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Optional: model id. Defaults to anthropic/claude-opus-5.5 on OpenRouter,
# claude-opus-5-5 on the direct Anthropic route.
SHOLAM_MODEL=
# Alternative route when OPENROUTER_API_KEY is empty: Anthropic directly, or a
# local gateway via ANTHROPIC_BASE_URL (CLIProxyAPI :18317, LiteLLM :4000).
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# low | medium | high | xhigh | max, or "off" to send no effort parameter
SHOLAM_EFFORT=medium
# "default" = server-side refusal fallbacks (direct Anthropic route only)
SHOLAM_FALLBACKS=off
# "live" = real agent loop (Phase 2). Anything else = scripted demo stream.
SHOLAM_AGENT=demo

# --- Supabase ----------------------------------------------------------
# Project settings -> API. The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Postgres via the transaction pooler (port 6543), used by the app, server only.
# Unset = flashcards come from data/flashcards.seed.json.
DATABASE_URL=
# Postgres via the session pooler (port 5432), for migrations and scripts.
DIRECT_URL=
