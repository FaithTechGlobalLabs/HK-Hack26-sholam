# Copy to .env.local and fill in. Never commit .env.local.

# --- Model -------------------------------------------------------------
# Anthropic API key. Or point ANTHROPIC_BASE_URL at a local gateway
# (CLIProxyAPI http://127.0.0.1:18317 or LiteLLM http://127.0.0.1:4000)
# and use that gateway's key here (LiteLLM: ANTHROPIC_AUTH_TOKEN instead).
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
SHOLAM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
SHOLAM_EFFORT=medium
# "default" = server-side refusal fallbacks (Anthropic API only; off via gateways)
SHOLAM_FALLBACKS=off
# "live" = real agent loop (Phase 2). Anything else = scripted demo stream.
SHOLAM_AGENT=demo

# --- Supabase ----------------------------------------------------------
# Project settings -> API. The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Postgres connection string (transaction pooler, port 6543), server only.
# Unset = flashcards come from data/flashcards.seed.json.
DATABASE_URL=
