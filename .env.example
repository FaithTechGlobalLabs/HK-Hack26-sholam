# Copy to .env.local and fill in. Never commit .env.local.

# --- Model (OpenRouter) ------------------------------------------------
# Server-only. Never prefix with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Optional override (default https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model id. Free models only: an id that does not end in :free is ignored
# and the default below is used (src/lib/agent/openrouter-config.ts).
# Free ids share a daily cap (about 50 requests until the OpenRouter account
# has purchased credits; 1000/day after about $10).
SHOLAM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# "live" forces the real guide (errors if the key is missing).
# "demo" forces the scripted stream. Unset = live when a key is present.
# SHOLAM_AGENT=live
# Optional: model requests per UTC day for everyone (default 800; see
# src/lib/agent/limits.ts) and a secret for hashing visitor IPs.
# SHOLAM_DAILY_MODEL_CALLS=800
# SHOLAM_RATE_LIMIT_SALT=

# --- Supabase ----------------------------------------------------------
# Project settings -> API. The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Postgres via the transaction pooler (port 6543), used by the app, server only.
# Unset = flashcards come from data/flashcards.seed.json.
DATABASE_URL=
# Postgres via the session pooler (port 5432), for migrations and scripts.
DIRECT_URL=

# --- Stripe (iOS Shalom Plus) ------------------------------------------
# Server only. Use a restricted key (rk_) with Checkout Sessions, Customers,
# Subscriptions, Prices, and the Customer Portal. Never put it in the app
# or in a NEXT_PUBLIC_ / EXPO_PUBLIC_ variable. Store it in the host's
# secret env (Vercel sensitive env), not in git.
STRIPE_SECRET_KEY=
# Signing secret from the webhook endpoint pointing at /api/billing/webhook.
# Required before launch. Renewals, failed payments, cancellations, disputes,
# refunds, and delayed payment methods are applied here, not on the success page.
STRIPE_WEBHOOK_SECRET=
# One Product per plan (Shalom Plus monthly, Shalom Plus yearly). Paste each
# Price id. Do not put both intervals on a single Product.
STRIPE_PRICE_PLUS_MONTH=
STRIPE_PRICE_PLUS_YEAR=
# Optional. Public origin used for Checkout return URLs.
# SHOLAM_PUBLIC_URL=http://localhost:5310
# Optional. Stable Checkout flow label. Otherwise the server generates one.
# SHOLAM_STRIPE_INTEGRATION_ID=
#
# Stripe Tax is not turned on in code. Turn it on in the Dashboard only after
# you have an active tax registration. Without one, automatic tax collects
# nothing. https://docs.stripe.com/billing/taxes/collect-taxes
#
# Webhook events to send:
# checkout.session.completed
# checkout.session.async_payment_succeeded
# checkout.session.async_payment_failed
# customer.subscription.updated
# customer.subscription.deleted
# invoice.paid
# invoice.payment_failed
# charge.dispute.created
# charge.dispute.closed
# charge.refunded
# radar.early_fraud_warning.created
